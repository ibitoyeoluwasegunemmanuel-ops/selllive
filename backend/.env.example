# ============================================================
# SELLLIVE ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values
# NEVER commit .env to git
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Supabase (get from supabase.com → project → settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT Secret (generate a random 64-char string)
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters-long-random-string

# Flutterwave (get from dashboard.flutterwave.com → API Keys)
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx
FLW_ENCRYPTION_KEY=xxxxxxxxxxxxxxxx
FLW_WEBHOOK_SECRET=your-webhook-secret

# Daily.co for video (get from dashboard.daily.co) — OPTIONAL at launch
# Without this, video rooms are not auto-created (add manually or skip for now)
# Get account at: daily.co (free: 1,000 mins/month)
DAILY_API_KEY=

# Termii for OTP SMS in Nigeria (https://termii.com) — OPTIONAL at launch
# Without this, OTP codes are returned directly in the API response
# Get account at: termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=SellLive

# App
APP_NAME=SellLive
APP_URL=https://selllive.ng
FRONTEND_URL=https://app.selllive.ng
COMMISSION_PERCENT=10
